--- a/src/luks/systemd/clevis-luks-askpass.in
+++ b/src/luks/systemd/clevis-luks-askpass.in
@@ -25,6 +25,13 @@
 # Make sure to exit cleanly if SIGTERM is received.
 trap 'echo "Exiting due to SIGTERM" && exit 0' TERM
 
+# The passphrase recovered for each device, kept until this process exits. A reply
+# can be lost: when another device's passphrase lands in the kernel keyring,
+# systemd-cryptsetup drops its pending question to try that one, and the reply to
+# the dropped question has no socket to go to. When the device asks again, it gets
+# the passphrase recovered for it already, not another key recovery from Tang.
+declare -A recovered=()
+
 loop=
 path=/run/systemd/ask-password
 while getopts ":lp:" o; do
@@ -53,8 +60,13 @@
         [ -e "${d}" ] || continue
         [ -S "${s}" ] || continue
 
-        if ! pt="$(clevis_luks_unlock_device "${d}")" || [ -z "${pt}" ]; then
+        pt="${recovered["${d}"]-}"
+        if [ -n "${pt}" ]; then
+            echo "Answering ${d} again with the passphrase recovered for it" >&2
+        elif ! pt="$(clevis_luks_unlock_device "${d}")" || [ -z "${pt}" ]; then
             continue
+        else
+            recovered["${d}"]="${pt}"
         fi
 
         uuid="$(cryptsetup luksUUID "${d}")"
